# ${name} — generated by terraform
fqdn          = ${server.fqdn}
port          = ${server.port}
instance_type = ${server.instance_type}
public        = ${server.public}
monitor       = ${server.monitor}

[ingress]
%{ for cidr in server.ingress_cidrs ~}
allow = ${cidr}
%{ endfor ~}

[tags]
%{ for k, v in tags ~}
${k} = ${v}
%{ endfor ~}
